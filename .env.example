# Backend
PORT=5002
PUBLIC_API_BASE_URL=http://localhost:5002
PUBLIC_FRONTEND_URL=http://localhost:5274

# Database
MONGO_PORT=27018
MONGODB_URI=mongodb://localhost:27018/hn-intelligence

# Decodo Web Scraping API
# Optional fallback/bootstrap: credentials saved in the Settings UI override this value.
# Paste the Basic Auth token only (without the word "Basic").
DECODO_AUTH_TOKEN=
DECODO_SCRAPER_ENDPOINT=https://scraper-api.decodo.com/v2/scrape

# External pages selected from Hacker News use:
# proxy_pool=premium
# headless=html
# markdown=true

# LLM Provider — pick one: claude | openai | gemini
# Optional fallback/bootstrap: credentials saved in the Settings UI override these keys.
LLM_PROVIDER=claude
LLM_MODEL=
# Optional. Leave blank to use a cheaper provider-specific model for triage.
LLM_TRIAGE_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
